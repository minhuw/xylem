{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProfileConfig",
  "description": "Top-level profile configuration",
  "type": "object",
  "properties": {
    "experiment": {
      "$ref": "#/$defs/ExperimentConfig"
    },
    "ntcp": {
      "description": "User-space TCP settings, required when a group uses transport \"ntcp\"",
      "anyOf": [
        {
          "$ref": "#/$defs/NtcpConfig"
        },
        {
          "type": "null"
        }
      ]
    },
    "output": {
      "$ref": "#/$defs/OutputConfig"
    },
    "request_dump": {
      "description": "Optional request dump configuration for recording all requests",
      "anyOf": [
        {
          "$ref": "#/$defs/DumpConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "stats": {
      "description": "Statistics collection configuration",
      "$ref": "#/$defs/StatsConfig",
      "default": {
        "bucket_duration": "1s",
        "include_records": false,
        "sampling_policy": null
      }
    },
    "traffic_groups": {
      "description": "Traffic groups configuration",
      "type": "array",
      "items": {
        "$ref": "#/$defs/TrafficGroupConfig"
      }
    }
  },
  "required": [
    "experiment",
    "traffic_groups",
    "output"
  ],
  "$defs": {
    "DataEncoding": {
      "description": "Encoding method for request data in dump files",
      "oneOf": [
        {
          "description": "Hexadecimal encoding (safe for all binary data)",
          "type": "string",
          "const": "hex"
        },
        {
          "description": "Base64 encoding (more compact than hex)",
          "type": "string",
          "const": "base64"
        },
        {
          "description": "UTF-8 with lossy conversion (replaces invalid bytes with replacement char)\nGood for text protocols like HTTP, Redis text commands",
          "type": "string",
          "const": "utf8"
        },
        {
          "description": "Raw bytes as escaped string (e.g., \\x00\\x01)",
          "type": "string",
          "const": "escaped"
        },
        {
          "description": "No data encoding - only record metadata (data_len, no data column)",
          "type": "string",
          "const": "none"
        }
      ]
    },
    "DumpConfig": {
      "description": "Configuration for request dumping",
      "type": "object",
      "properties": {
        "directory": {
          "description": "Directory to store dump files",
          "type": "string"
        },
        "encoding": {
          "description": "Data encoding method",
          "$ref": "#/$defs/DataEncoding",
          "default": "hex"
        },
        "max_files": {
          "description": "Maximum number of closed rotated files to keep (None = unlimited).\nActive files (one per worker) are additional and never removed by retention.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "default": null,
          "minimum": 0
        },
        "prefix": {
          "description": "Prefix for dump file names",
          "type": "string",
          "default": "xylem_requests"
        },
        "rotation": {
          "description": "Rotation policy",
          "$ref": "#/$defs/RotationPolicy",
          "default": "never"
        }
      },
      "required": [
        "directory"
      ]
    },
    "ExperimentConfig": {
      "description": "Experiment metadata",
      "type": "object",
      "properties": {
        "description": {
          "description": "Optional description",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "drain_timeout": {
          "description": "Longest wait for pending responses after the measurement window\n(default 1s). Requests still pending then count as timed out.",
          "type": "string",
          "default": "1s"
        },
        "duration": {
          "description": "Experiment duration",
          "type": "string"
        },
        "name": {
          "description": "Experiment name",
          "type": "string"
        },
        "seed": {
          "description": "Random seed for reproducibility (None = use entropy)",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "default": null,
          "minimum": 0
        }
      },
      "required": [
        "name",
        "duration"
      ]
    },
    "HtmlOutputConfig": {
      "description": "HTML output configuration",
      "type": "object",
      "properties": {
        "library": {
          "description": "Chart library; only \"chartjs\" is currently supported.",
          "type": "string",
          "default": "chartjs"
        },
        "theme": {
          "description": "Theme; only \"light\" is currently supported.",
          "type": "string",
          "default": "light"
        }
      }
    },
    "NtcpBackend": {
      "description": "Packet backend of the ntcp transport",
      "oneOf": [
        {
          "description": "An existing Linux TUN device (IFF_TUN | IFF_NO_PI)",
          "type": "string",
          "const": "tun"
        }
      ]
    },
    "NtcpConfig": {
      "description": "User-space TCP (ntcp) settings, required when a traffic group uses\n`transport = \"ntcp\"`",
      "type": "object",
      "properties": {
        "backend": {
          "description": "Packet backend; only \"tun\" (an existing Linux TUN device) for now",
          "$ref": "#/$defs/NtcpBackend",
          "default": "tun"
        },
        "endpoints": {
          "description": "One endpoint per worker thread that runs ntcp traffic groups, in\nascending thread-id order",
          "type": "array",
          "items": {
            "$ref": "#/$defs/NtcpEndpoint"
          }
        },
        "mtu": {
          "description": "IP MTU of every endpoint's link",
          "type": "integer",
          "format": "uint32",
          "default": 1500,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "endpoints"
      ]
    },
    "NtcpEndpoint": {
      "description": "The device and address one worker thread's ntcp stack uses",
      "type": "object",
      "properties": {
        "ifname": {
          "description": "Name of the TUN interface (e.g. \"ntcp0\")",
          "type": "string"
        },
        "local_ip": {
          "description": "ntcp's own IP address on that link, not one of the kernel's",
          "type": "string",
          "format": "ip"
        }
      },
      "additionalProperties": false,
      "required": [
        "ifname",
        "local_ip"
      ]
    },
    "OutputConfig": {
      "description": "Output configuration",
      "type": "object",
      "properties": {
        "file": {
          "description": "Output file path (for json/html, extensions will be added automatically)",
          "type": "string"
        },
        "format": {
          "description": "Output format: json, html, both, or human",
          "$ref": "#/$defs/OutputFormat",
          "default": "json"
        },
        "html": {
          "description": "HTML chart configuration",
          "$ref": "#/$defs/HtmlOutputConfig",
          "default": {
            "library": "chartjs",
            "theme": "light"
          }
        },
        "real_time": {
          "description": "Reserved for real-time updates; must be false (not supported by the CLI).",
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "file"
      ]
    },
    "OutputFormat": {
      "description": "Output format options",
      "oneOf": [
        {
          "description": "JSON format with per-group breakdown.\nUse `[stats] include_records = true` to include per-second per-connection records.",
          "type": "string",
          "const": "json"
        },
        {
          "description": "HTML report with visualizations",
          "type": "string",
          "const": "html"
        },
        {
          "description": "Both JSON and HTML",
          "type": "string",
          "const": "both"
        },
        {
          "description": "Human-readable console output only (no file)",
          "type": "string",
          "const": "human"
        }
      ]
    },
    "PolicyConfig": {
      "description": "Policy configuration for traffic groups",
      "oneOf": [
        {
          "description": "Closed-loop policy (max throughput)",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "closed-loop"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Fixed-rate policy",
          "type": "object",
          "properties": {
            "rate": {
              "description": "Rate in requests per second",
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "fixed-rate"
            }
          },
          "required": [
            "type",
            "rate"
          ]
        },
        {
          "description": "Poisson policy",
          "type": "object",
          "properties": {
            "rate": {
              "description": "Average rate in requests per second",
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "poisson"
            }
          },
          "required": [
            "type",
            "rate"
          ]
        },
        {
          "description": "Adaptive policy",
          "type": "object",
          "properties": {
            "initial_rate": {
              "description": "Initial rate in requests per second",
              "type": "number",
              "format": "double"
            },
            "max_rate": {
              "description": "Maximum rate (cap)",
              "type": "number",
              "format": "double",
              "default": 10000000.0
            },
            "min_rate": {
              "description": "Minimum rate (fallback)",
              "type": "number",
              "format": "double",
              "default": 100.0
            },
            "target_latency_us": {
              "description": "Target latency in microseconds",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "adaptive"
            }
          },
          "required": [
            "type",
            "initial_rate",
            "target_latency_us"
          ]
        },
        {
          "description": "Sinusoidal pattern - varies rate following a sine wave (e.g., diurnal patterns)",
          "type": "object",
          "properties": {
            "amplitude": {
              "description": "Amplitude - how much rate varies above/below base",
              "type": "number",
              "format": "double"
            },
            "base_rate": {
              "description": "Base rate (center of oscillation) in requests per second",
              "type": "number",
              "format": "double"
            },
            "period": {
              "description": "Period duration (e.g., \"60s\", \"24h\")",
              "type": "string"
            },
            "phase_shift": {
              "description": "Optional phase shift",
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "type": {
              "type": "string",
              "const": "sinusoidal"
            }
          },
          "required": [
            "type",
            "base_rate",
            "amplitude",
            "period"
          ]
        },
        {
          "description": "Ramp pattern - linearly increase/decrease rate over time",
          "type": "object",
          "properties": {
            "duration": {
              "description": "Ramp duration",
              "type": "string"
            },
            "end_rate": {
              "description": "Ending rate in requests per second",
              "type": "number",
              "format": "double"
            },
            "start_rate": {
              "description": "Starting rate in requests per second",
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "ramp"
            }
          },
          "required": [
            "type",
            "start_rate",
            "end_rate",
            "duration"
          ]
        },
        {
          "description": "Spike pattern - sudden burst of traffic",
          "type": "object",
          "properties": {
            "normal_rate": {
              "description": "Normal baseline rate in requests per second",
              "type": "number",
              "format": "double"
            },
            "spike_duration": {
              "description": "How long the spike lasts",
              "type": "string"
            },
            "spike_rate": {
              "description": "Peak rate during spike",
              "type": "number",
              "format": "double"
            },
            "spike_start": {
              "description": "When the spike starts",
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "spike"
            }
          },
          "required": [
            "type",
            "normal_rate",
            "spike_rate",
            "spike_start",
            "spike_duration"
          ]
        },
        {
          "description": "Sawtooth pattern - repeated ramps (ramp up, instant drop, repeat)",
          "type": "object",
          "properties": {
            "max_rate": {
              "description": "Maximum rate (end of ramp)",
              "type": "number",
              "format": "double"
            },
            "min_rate": {
              "description": "Minimum rate (start of ramp)",
              "type": "number",
              "format": "double"
            },
            "period": {
              "description": "Period for one complete cycle",
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "sawtooth"
            }
          },
          "required": [
            "type",
            "min_rate",
            "max_rate",
            "period"
          ]
        }
      ]
    },
    "RotationPolicy": {
      "description": "Rotation policy for request dump files",
      "oneOf": [
        {
          "description": "Never rotate - single file",
          "type": "string",
          "const": "never"
        },
        {
          "description": "Rotate every minute",
          "type": "string",
          "const": "minutely"
        },
        {
          "description": "Rotate every hour",
          "type": "string",
          "const": "hourly"
        },
        {
          "description": "Rotate every day",
          "type": "string",
          "const": "daily"
        },
        {
          "description": "Rotate when file exceeds size (in bytes)",
          "type": "object",
          "properties": {
            "size": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "size"
          ]
        }
      ]
    },
    "SamplingPolicy": {
      "description": "Sampling policy configuration for latency measurement",
      "oneOf": [
        {
          "description": "Disable latency sampling entirely (still counts bytes/requests)",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Uniform random sample of at most `max_samples` latencies per entry.\nEach latency is first kept with probability `rate`; the kept latencies\nare reservoir-sampled, so the stored samples are a uniform sample of\nevery kept latency, not the first ones. Mean, min, max and standard\ndeviation are computed from every kept latency.",
          "type": "object",
          "properties": {
            "max_samples": {
              "description": "Maximum number of samples to store",
              "type": "integer",
              "format": "uint",
              "default": 131072,
              "minimum": 0
            },
            "rate": {
              "description": "Sampling rate (0.0 to 1.0)",
              "type": "number",
              "format": "double",
              "default": 1.0
            },
            "type": {
              "type": "string",
              "const": "limited"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Zero sampling: record every latency (unlimited storage)\nWARNING: Can consume large amounts of memory for high-throughput workloads",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "unlimited"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "DDSketch: Distributed quantile sketch with relative-error guarantees\nMemory-efficient and fully mergeable across traffic groups",
          "type": "object",
          "properties": {
            "alpha": {
              "description": "Relative accuracy parameter (e.g., 0.01 = 1% error)",
              "type": "number",
              "format": "double",
              "default": 0.01
            },
            "max_bins": {
              "description": "Maximum number of bins (in steps of 128)",
              "type": "integer",
              "format": "uint32",
              "default": 1024,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "dd-sketch"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "T-Digest: Adaptive clustering sketch optimized for extreme tail percentiles\nBetter accuracy than DDSketch for p999+, fully mergeable",
          "type": "object",
          "properties": {
            "compression": {
              "description": "Compression parameter (higher = more accurate, more memory)\nTypical values: 100-1000",
              "type": "integer",
              "format": "uint",
              "default": 1000,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "t-digest"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "HDR Histogram: records every latency with bounded relative error.\nThis is the default policy.",
          "type": "object",
          "properties": {
            "max_value_us": {
              "description": "Optional upper bound (in microseconds). When unset, the histogram\ngrows to fit every recorded value. When set, larger values are\nrecorded as this bound and counted in the `clamped_samples` output.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "sigfigs": {
              "description": "Number of significant digits (1-5)\nHigher = more accurate but more memory",
              "type": "integer",
              "format": "uint8",
              "default": 3,
              "maximum": 255,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "hdr-histogram"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "StatsConfig": {
      "description": "Statistics collection configuration",
      "type": "object",
      "properties": {
        "bucket_duration": {
          "description": "Time bucket duration for per-second per-connection records",
          "type": "string",
          "default": "1s"
        },
        "include_records": {
          "description": "Include per-second per-connection records in JSON output",
          "type": "boolean",
          "default": false
        },
        "sampling_policy": {
          "description": "Global latency sampling policy for the aggregated collector.\nIf unset, the first traffic group's policy is used (current behavior).\nSet to \"none\" to disable global latency recording.",
          "anyOf": [
            {
              "$ref": "#/$defs/SamplingPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "TrafficGroupConfig": {
      "description": "Traffic group configuration",
      "type": "object",
      "properties": {
        "connections_per_thread": {
          "description": "Number of connections per thread",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "max_pending_per_connection": {
          "description": "Maximum pending requests per connection",
          "type": "integer",
          "format": "uint",
          "default": 10,
          "minimum": 0
        },
        "name": {
          "description": "Group name for identification",
          "type": "string"
        },
        "protocol": {
          "description": "Protocol for this group (redis, memcached-binary, memcached-ascii, http, xylem-echo)",
          "type": "string"
        },
        "protocol_config": {
          "description": "Protocol-specific configuration as a JSON value.\nEach protocol factory interprets this according to its own schema.\nThe core is protocol-agnostic - this value is passed directly to the protocol factory.",
          "default": null
        },
        "request_timeout": {
          "description": "How long a request may wait for its response before it times out,\nfrees its pipeline slot, and counts as timed out without a latency\n(e.g., \"500ms\"). Only for transport \"udp\", where it defaults to 1s;\nstream transports retransmit and never time out requests.",
          "type": [
            "string",
            "null"
          ]
        },
        "sampling_policy": {
          "description": "Latency sampling policy",
          "$ref": "#/$defs/SamplingPolicy",
          "default": {
            "sigfigs": 3,
            "type": "hdr-histogram"
          }
        },
        "target": {
          "description": "Target address for this group (e.g., \"127.0.0.1:6379\" or \"/var/run/redis.sock\")",
          "type": "string"
        },
        "threads": {
          "description": "Thread IDs this group runs on",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint",
            "minimum": 0
          }
        },
        "traffic_policy": {
          "description": "Traffic policy configuration (rate control)",
          "$ref": "#/$defs/PolicyConfig"
        },
        "transport": {
          "description": "Transport layer: tcp, udp, unix (defaults to \"tcp\")",
          "type": "string",
          "default": "tcp"
        }
      },
      "required": [
        "name",
        "protocol",
        "target",
        "threads",
        "connections_per_thread",
        "traffic_policy"
      ]
    }
  }
}
